{
  "name": "@alosha/stride",
  "version": "3.0.0",
  "description": "Parse GPX, TCX and FIT files and compute running metrics \u2014 pace, HR zones, splits, and Chart.js dashboards. Zero config.",
  "keywords": [
    "gpx",
    "gpx-parser",
    "fit",
    "fit-parser",
    "fit-file",
    "tcx",
    "tcx-parser",
    "running",
    "strava",
    "garmin",
    "activity",
    "heart-rate",
    "heart-rate-zones",
    "pace",
    "splits",
    "chartjs",
    "chart",
    "activity-analysis",
    "fitness",
    "cli"
  ],
  "homepage": "https://stride.alosha.dev",
  "bugs": {
    "url": "https://github.com/avlisodraude/stride/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avlisodraude/stride.git"
  },
  "license": "MIT",
  "author": "Eduardo Silva Navarrete <avlis_odraude@hotmail.com>",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./charts": {
      "import": {
        "types": "./dist/charts.d.ts",
        "default": "./dist/charts.js"
      },
      "require": {
        "types": "./dist/charts.d.cts",
        "default": "./dist/charts.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "bin": {
    "stride": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "MIGRATING.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && npm run build:browser",
    "build:browser": "node scripts/build-browser.mjs",
    "dev": "tsup --watch",
    "pretest": "npm run build",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "sample:fit": "node scripts/make-sample-fit.mjs test/fixtures/sample-run.fit",
    "sample:climb": "node scripts/make-climb-fit.mjs test/fixtures/climb-run.fit",
    "lint": "eslint src",
    "prepare": "husky",
    "release": "npm run release:preflight && npm run check && npm run release:preflight && npm publish --access public",
    "test:real": "node scripts/test-real.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:examples": "node scripts/test-examples.mjs",
    "sample:multisession": "node scripts/make-multisession-fit.mjs",
    "check": "npm run lint && npm test -- --runInBand && npm run test:package && npm run test:examples && npm run test:browser && npm run test:performance",
    "test:browser": "node test/browser/run.mjs",
    "browser:install": "node test/browser/install.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "prepublishOnly": "npm run release:preflight",
    "test:performance": "node --expose-gc scripts/test-performance.mjs",
    "test:real:all": "node scripts/test-real.mjs --require-all-formats"
  },
  "dependencies": {
    "@garmin/fitsdk": "^21.218.0",
    "fast-xml-parser": "^5.11.2",
    "saxes": "6.0.0"
  },
  "peerDependencies": {
    "chart.js": "^4.4.3"
  },
  "peerDependenciesMeta": {
    "chart.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "chart.js": "^4.6.1",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "js-yaml": "4.3.2"
  }
}
